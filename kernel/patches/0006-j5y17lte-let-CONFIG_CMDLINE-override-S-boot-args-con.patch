From fc867f424d68cb5651f5a6d9e66dcabfa6e2c231 Mon Sep 17 00:00:00 2001
From: highcmd <9810278+highcmd@users.noreply.github.com>
Date: Tue, 17 Nov 2026 19:59:17 +0100
Subject: [PATCH 6/9] j5y17lte: let CONFIG_CMDLINE override S-boot args
 (console), move cmdline to kernel config

---
 debian/kernel-info.mk          |  3 ++-
 debian/path-override/python2   |  1 +
 debian/path-override/python2.7 |  1 +
 drivers/of/fdt.c               | 14 +++++++-------
 droidian/j5y17lte.config       |  2 ++
 5 files changed, 13 insertions(+), 8 deletions(-)
 create mode 120000 debian/path-override/python2
 create mode 120000 debian/path-override/python2.7

diff --git a/debian/kernel-info.mk b/debian/kernel-info.mk
index cd060127..b33ccf92 100644
--- a/debian/kernel-info.mk
+++ b/debian/kernel-info.mk
@@ -4,7 +4,8 @@
 VARIANT = android
 KERNEL_BASE_VERSION = 3.18.140
 # Exynos 3.18 + systemd >= 256 needs cgroup v1 forced
-KERNEL_BOOTIMAGE_CMDLINE = console=tty0 droidian.lvm.prefer systemd.unified_cgroup_hierarchy=0 SYSTEMD_CGROUP_ENABLE_LEGACY_FORCE=1 systemd.journald.forward_to_kmsg=yes log_buf_len=4M
+# NOTE: S-boot ignores this; the effective cmdline is CONFIG_CMDLINE (droidian/j5y17lte.config)
+KERNEL_BOOTIMAGE_CMDLINE = androidboot.selinux=permissive console=tty0 systemd.unified_cgroup_hierarchy=0 SYSTEMD_CGROUP_ENABLE_LEGACY_FORCE=1 systemd.journald.forward_to_kmsg=yes log_buf_len=4M
 
 DEVICE_VENDOR = samsung
 DEVICE_MODEL = j5y17lte
diff --git a/debian/path-override/python2 b/debian/path-override/python2
new file mode 120000
index 00000000..7f0b0cf7
--- /dev/null
+++ b/debian/path-override/python2
@@ -0,0 +1 @@
+/opt/android/prebuilts/python/2.7.5/bin/python2
\ No newline at end of file
diff --git a/debian/path-override/python2.7 b/debian/path-override/python2.7
new file mode 120000
index 00000000..5cffa255
--- /dev/null
+++ b/debian/path-override/python2.7
@@ -0,0 +1 @@
+/opt/android/prebuilts/python/2.7.5/bin/python2.7
\ No newline at end of file
diff --git a/drivers/of/fdt.c b/drivers/of/fdt.c
index d0528e43..a18dba88 100644
--- a/drivers/of/fdt.c
+++ b/drivers/of/fdt.c
@@ -940,14 +940,14 @@ int __init early_init_dt_scan_chosen(unsigned long node, const char *uname,
 
 	if (p != NULL && l > 0) {
 		if (concat_cmdline) {
-			int cmdline_len;
-			int copy_len;
+			/*
+			 * Droidian: Samsung S-boot ignores the boot.img cmdline and
+			 * passes e.g. "console=ram". Put the bootloader args first
+			 * and CONFIG_CMDLINE last, so that our values take precedence.
+			 */
+			strlcpy(cmdline, p, min((int)l, COMMAND_LINE_SIZE));
 			strlcat(cmdline, " ", COMMAND_LINE_SIZE);
-			cmdline_len = strlen(cmdline);
-			copy_len = COMMAND_LINE_SIZE - cmdline_len - 1;
-			copy_len = min((int)l, copy_len);
-			strncpy(cmdline + cmdline_len, p, copy_len);
-			cmdline[cmdline_len + copy_len] = '\0';
+			strlcat(cmdline, config_cmdline, COMMAND_LINE_SIZE);
 		} else {
 			strlcpy(cmdline, p, min((int)l, COMMAND_LINE_SIZE));
 		}
diff --git a/droidian/j5y17lte.config b/droidian/j5y17lte.config
index 03a621a7..eddccbb2 100644
--- a/droidian/j5y17lte.config
+++ b/droidian/j5y17lte.config
@@ -33,3 +33,5 @@ CONFIG_USB_NET_RNDIS_WLAN=n
 CONFIG_TUN=y
 CONFIG_UHID=y
 CONFIG_INPUT_UINPUT=y
+CONFIG_CMDLINE="androidboot.selinux=permissive console=tty0 systemd.unified_cgroup_hierarchy=0 SYSTEMD_CGROUP_ENABLE_LEGACY_FORCE=1 systemd.journald.forward_to_kmsg=yes log_buf_len=4M"
+CONFIG_CMDLINE_EXTEND=y
-- 
2.47.3

