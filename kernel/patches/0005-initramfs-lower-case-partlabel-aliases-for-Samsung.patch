From 7d24b8b3798d7482ebfc187a6a97556714578544 Mon Sep 17 00:00:00 2001
From: highcmd <9810278+highcmd@users.noreply.github.com>
Date: Tue, 17 Nov 2026 19:31:56 +0100
Subject: [PATCH 5/9] initramfs: lower-case partlabel aliases for Samsung

---
 .../udev/rules.d/61-samsung-lowercase-partlabels.rules   | 9 +++++++++
 1 file changed, 9 insertions(+)
 create mode 100644 debian/initramfs-overlay/lib/udev/rules.d/61-samsung-lowercase-partlabels.rules

diff --git a/debian/initramfs-overlay/lib/udev/rules.d/61-samsung-lowercase-partlabels.rules b/debian/initramfs-overlay/lib/udev/rules.d/61-samsung-lowercase-partlabels.rules
new file mode 100644
index 00000000..2e516bab
--- /dev/null
+++ b/debian/initramfs-overlay/lib/udev/rules.d/61-samsung-lowercase-partlabels.rules
@@ -0,0 +1,9 @@
+# Samsung Exynos: partition names are upper-case; Halium/Droidian look for lower-case ones
+SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="BOOT", SYMLINK+="disk/by-partlabel/boot"
+SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="RECOVERY", SYMLINK+="disk/by-partlabel/recovery"
+SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="SYSTEM", SYMLINK+="disk/by-partlabel/system"
+SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="VENDOR", SYMLINK+="disk/by-partlabel/vendor"
+SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="USERDATA", SYMLINK+="disk/by-partlabel/userdata"
+SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="CACHE", SYMLINK+="disk/by-partlabel/cache"
+SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="EFS", SYMLINK+="disk/by-partlabel/efs"
+SUBSYSTEM=="block", ENV{ID_PART_ENTRY_NAME}=="PERSISTENT", SYMLINK+="disk/by-partlabel/persistent"
-- 
2.47.3

