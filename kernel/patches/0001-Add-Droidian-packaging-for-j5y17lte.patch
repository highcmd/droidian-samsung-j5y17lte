diff --git a/debian/kernel-info.mk b/debian/kernel-info.mk
new file mode 100644
index 00000000..cd060127
--- /dev/null
+++ b/debian/kernel-info.mk
@@ -0,0 +1,61 @@
+########################################################################
+# Samsung Galaxy J5 (2017) - SM-J530F - Exynos 7870
+########################################################################
+VARIANT = android
+KERNEL_BASE_VERSION = 3.18.140
+# Exynos 3.18 + systemd >= 256 needs cgroup v1 forced
+KERNEL_BOOTIMAGE_CMDLINE = console=tty0 droidian.lvm.prefer systemd.unified_cgroup_hierarchy=0 SYSTEMD_CGROUP_ENABLE_LEGACY_FORCE=1 systemd.journald.forward_to_kmsg=yes log_buf_len=4M
+
+DEVICE_VENDOR = samsung
+DEVICE_MODEL = j5y17lte
+DEVICE_FULL_NAME = Samsung Galaxy J5 (2017)
+
+KERNEL_CONFIG_USE_FRAGMENTS = 1
+KERNEL_CONFIG_USE_DIFFCONFIG = 0
+KERNEL_DEFCONFIG = exynos7870-j5y17lte_defconfig
+
+# DT is shipped as a separate Exynos dt.img (dtbtool_exynos), not appended
+KERNEL_IMAGE_WITH_DTB = 0
+KERNEL_IMAGE_WITH_DTB_OVERLAY = 0
+KERNEL_IMAGE_WITH_DTB_OVERLAY_IN_KERNEL = 0
+KERNEL_PREBUILT_DT = out/KERNEL_OBJ/arch/arm64/boot/dtb.img
+
+# Values from postmarketOS deviceinfo (samsung-j5y17lte)
+KERNEL_BOOTIMAGE_PAGE_SIZE = 2048
+KERNEL_BOOTIMAGE_BASE_OFFSET = 0x10000000
+KERNEL_BOOTIMAGE_KERNEL_OFFSET = 0x00008000
+KERNEL_BOOTIMAGE_INITRAMFS_OFFSET = 0x01000000
+KERNEL_BOOTIMAGE_SECONDIMAGE_OFFSET = 0x00f00000
+KERNEL_BOOTIMAGE_TAGS_OFFSET = 0x00000100
+KERNEL_BOOTIMAGE_DTB_OFFSET =
+KERNEL_BOOTIMAGE_VERSION = 0
+KERNEL_INITRAMFS_COMPRESSION = gz
+KERNEL_BOOTIMAGE_GENERATE_VENDOR_BOOT = 0
+
+DEVICE_VBMETA_REQUIRED = 0
+DEVICE_VBMETA_IS_SAMSUNG = 0
+
+FLASH_ENABLED = 1
+FLASH_IS_AONLY = 0
+FLASH_IS_LEGACY_DEVICE = 1
+FLASH_IS_EXYNOS = 1
+FLASH_USE_TELNET = 0
+FLASH_INFO_MANUFACTURER = samsung
+FLASH_INFO_MODEL = SM-J530F
+FLASH_INFO_CPU = Exynos7870
+FLASH_INFO_DEVICE_IDS = j5y17lte
+
+BUILD_CROSS = 1
+BUILD_TRIPLET = aarch64-linux-android-
+BUILD_CLANG_TRIPLET = aarch64-linux-gnu-
+BUILD_CC = aarch64-linux-android-gcc
+BUILD_LLVM = 0
+BUILD_SKIP_MODULES = 0
+CLANG_VERSION = 6.0-4691093
+CLANG_CUSTOM = 1
+BUILD_PATH = /usr/lib/llvm-android-6.0-4691093/bin
+DEB_TOOLCHAIN = linux-initramfs-halium-generic:arm64, binutils-aarch64-linux-gnu, gcc-4.9-aarch64-linux-android, g++-4.9-aarch64-linux-android, libgcc-4.9-dev-aarch64-linux-android-cross, device-tree-compiler, python3
+DEB_BUILD_ON = amd64
+DEB_BUILD_FOR = arm64
+KERNEL_ARCH = arm64
+KERNEL_BUILD_TARGET = Image
